{
  "expo": {
    "name": "NexusPayOrchestrator",
    "slug": "NexusPayOrchestrator",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexuspayorchestrator",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "NexusPay uses the camera to capture identity documents and complete liveness verification.",
        "NSMicrophoneUsageDescription": "NexusPay uses the microphone when a Sumsub verification step requires video.",
        "NSPhotoLibraryUsageDescription": "NexusPay can use a selected photo when an identity document is uploaded.",
        "NSLocationWhenInUseUsageDescription": "NexusPay may use location when required by the selected verification workflow."
      }
    },
    "android": {
      "versionCode": 4,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#07111F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nexuspay.orchestrator"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#07111F",
          "dark": {
            "backgroundColor": "#07111F"
          }
        }
      ],
      "expo-secure-store",
      "./plugins/withSumsubAndroid"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "35f8cdd6-557f-493d-b065-52d6121f62d3"
      }
    },
    "runtimeVersion": "1.0.1",
    "updates": {
      "url": "https://u.expo.dev/35f8cdd6-557f-493d-b065-52d6121f62d3",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
